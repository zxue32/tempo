# ───────────── 数据库（Supabase → Project Settings → Database → Connection string）
# 网站运行用：Transaction pooler（端口 6543）
DATABASE_URL=postgresql://postgres.xxxxxxxx:你的数据库密码@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# 建表（npm run db:migrate）用：Session pooler（端口 5432）或 Direct connection
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxx:你的数据库密码@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# 每个服务器实例的数据库连接数（一般不用改）
DB_POOL_MAX=3

# ───────────── 网站
# 正式网址，不要以 / 结尾。邮件里的链接、二维码都用它
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
# 平台名字（显示在页头、邮件里）
NEXT_PUBLIC_PLATFORM_NAME=Tempo

# ───────────── 登录（Supabase → Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ───────────── 图片上传（Logo、封面、员工头像、客人参考图）
# Supabase → Project Settings → API Keys → Secret keys。只放在服务器端，绝对不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# Supabase → Storage 里新建的公开 bucket 名字
STORAGE_BUCKET=media

# ───────────── 邮件（resend.com，免费额度每月 3000 封）
# 不填就不发邮件，预约照常可用
RESEND_API_KEY=re_xxxxxxxx
# 发件人，域名必须在 Resend 里验证过；没有域名时先用 onboarding@resend.dev（只能发给你自己）
EMAIL_FROM=Tempo <bookings@yourdomain.com>

# ───────────── 平台管理员（可以审核店铺的邮箱，多个用逗号分开）
PLATFORM_ADMIN_EMAILS=you@example.com

# ───────────── 提醒邮件定时任务的密码（随便一串长字符，GitHub Actions 里填同一个）
CRON_SECRET=换成一串很长的随机字符

# ───────────── 只在本地开发用：1 = 不用 Supabase，输入邮箱就能登录。正式环境自动失效
DEV_FAKE_AUTH=
