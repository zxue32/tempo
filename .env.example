# ───────────── 数据库（Supabase → 项目顶部 Connect）
# 网站运行用：Transaction pooler（端口 6543）
DATABASE_URL=postgresql://postgres.xxxxxxxx:你的数据库密码@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# 建表（npm run db:migrate）用：Session pooler（端口 5432）或 Direct connection
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxx:你的数据库密码@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# 每个服务器实例的数据库连接数（一般不用改）
DB_POOL_MAX=2

# ───────────── 网站
# 正式网址，不要以 / 结尾。邮件里的链接、二维码、员工加入链接都用它
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
# 平台名字（显示在页头、邮件里）
NEXT_PUBLIC_PLATFORM_NAME=Tempo

# ───────────── 平台管理员
# 可以审核店铺的邮箱，多个用逗号分开
PLATFORM_ADMIN_EMAILS=you@example.com
# 注册管理员账号时要填的码（只有你知道）。没有这个码，用上面的邮箱注册也不是管理员
ADMIN_SETUP_CODE=换成一串只有你知道的字符

# ───────────── 定时任务的密码（随便一串长字符）
CRON_SECRET=换成一串很长的随机字符

# ───────────── 邮件（resend.com，免费额度每天 100 封）。不填就不发邮件，预约照常可用
RESEND_API_KEY=
# 发件人，域名必须在 Resend 里验证过；没有域名时先用 onboarding@resend.dev（只能发给你自己）
EMAIL_FROM=Tempo <bookings@yourdomain.com>

# ───────────── 照片存储（可选）。不填时照片存在数据库里，几家店完全够用
# 填了就改存 Supabase Storage（Project Settings → API Keys → Secret keys；Storage 里建公开 bucket）
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=media

# ───────────── 只在本地开发用：1 = 输入邮箱就能登录，不用密码。正式环境自动失效
DEV_FAKE_AUTH=
